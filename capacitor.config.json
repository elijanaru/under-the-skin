{
  "appId": "com.elijanaru.undertheskin",
  "appName": "Underskin",
  "webDir": "www",
  "backgroundColor": "#a9809a",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#a9809a"
  },
  "android": {
    "backgroundColor": "#a9809a"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 300,
      "backgroundColor": "#a9809a",
      "showSpinner": false,
      "launchFadeOutDuration": 200
    },
    "SystemBars": {
      "style": "DARK"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true,
        "facebook": false,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
